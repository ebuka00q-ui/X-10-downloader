/* style.css */
* { box-sizing: border-box; }
body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #0a0a0f; color: white; font-family: sans-serif; }

.app-shell { display: flex; flex-direction: column; height: 100vh; width: 100vw; }

header { height: 70px; padding: 10px; border-bottom: 2px solid #ff007f; display: flex; gap: 8px; align-items: center; background: #0a0a0f; }
#search-input { flex: 1; height: 45px; padding: 10px; border-radius: 8px; border: none; background: #1a1a24; color: white; }
#search-btn { height: 45px; padding: 0 20px; border-radius: 8px; border: none; background: #ff007f; color: white; font-weight: bold; cursor: pointer; }

#view-area { flex: 1; overflow-y: auto; padding: 15px; }

footer { height: 60px; display: flex; border-top: 2px solid #ff007f; background: #0a0a0f; }
.nav-btn { flex: 1; display: flex; justify-content: center; align-items: center; cursor: pointer; font-weight: bold; color: #ff007f; }

.card { background: #1a1a24; padding: 15px; margin-bottom: 10px; border-radius: 8px; border-left: 4px solid #ff007f; }
